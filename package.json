{
  "name": "nodepower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-command VPS benchmark runner with realtime browser reports.",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"cross-env NODEPOWER_ROOT=. NODEPOWER_DEV_PUBLIC_BASE_URL=http://localhost:5173 tsx watch src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:api": "cross-env NODEPOWER_ROOT=. tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc && vite build && node scripts/copy-static.mjs",
    "start": "node dist/src/server/index.js",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "nanoid": "^5.1.6",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}
